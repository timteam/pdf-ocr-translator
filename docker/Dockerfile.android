# Android Flutter APK Build
# This Dockerfile builds a signed APK for Google Play Store deployment
# Usage: docker build -f docker/Dockerfile.android -t flutter-apk-builder .
# Then: docker run --rm -v $(pwd)/builds:/app/build flutter-apk-builder

FROM ghcr.io/cirruslabs/flutter:latest

WORKDIR /app

# Copy Flutter project
COPY flutter_app/ .

# Get dependencies
RUN flutter pub get

# Build APK (unsigned - you need to sign it separately for Play Store)
RUN flutter build apk --release --split-per-abi

# Copy APK to output directory
RUN mkdir -p /app/build && \
    cp build/app/outputs/flutter-apk/app-release.apk /app/build/ && \
    cp build/app/outputs/flutter-apk/app-armeabi-v7a-release.apk /app/build/ 2>/dev/null || true && \
    cp build/app/outputs/flutter-apk/app-arm64-v8a-release.apk /app/build/ 2>/dev/null || true && \
    cp build/app/outputs/flutter-apk/app-x86_64-release.apk /app/build/ 2>/dev/null || true

# Output the APK
CMD ["echo", "APK built successfully. Copy from /app/build/ directory for Play Store deployment"]
