# Backend Environment Variables
# Copy this file to .env and update values as needed

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# OCR Settings
OCR_DPI=150
OCR_LANGUAGES=eng

# Translation Settings
TRANSLATION_DEVICE=-1  # -1 for CPU, 0+ for GPU
TRANSLATION_MAX_LENGTH=512

# Processing Settings
MAX_PDF_PAGES=500
CHUNK_SIZE=32

# Directories
OUTPUT_DIR=./output
LOGS_DIR=./logs
MODELS_DIR=./models

# Debug Mode
DEBUG=False
